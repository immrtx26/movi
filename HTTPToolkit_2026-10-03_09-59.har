, zstd"},{"name":"Accept-Language","value":"es-US,es-419;q=0.9,es;q=0.8"},{"name":"Cookie","value":"cf_clearance=OotL8zgXDxosCK9Xtwc9B9Hb9ohLM.FIrHrPS_l1z.M-1791024984-1.2.1.1-h2_EDtBw3K04Yyc67kCeqqjHel8CAztIky1KbsrgQEdlhxFHPzeY7sAU9ynZQo4jqjDBzd_3lI9rCjNb.BvhsXTtsleYU6yuaqcuvfTLr2fuWkNsOc5s2gFjudD9FKFlwuGDll1XZA6EhHL_.0G62M.rnjQVUe41f215MNF_DbcwtnYVVR9hYxarDmUEPBTxZkiExo.Ocs25jTI_IA7UXXzmYjgbW.wlKF_2Y8RVEBQmP85o0G07sXq5NUVdyEiI7okJSal189.hWWfcYgh9mcotSHwDSwYBoW7RdZI1xWgPN6KqEyoNK._3ohqtBhwAic1aCAwo99YxU1lLFncxacx9F2GuvUfFRVvCJTIDKDM"}],"queryString":[],"headersSize":-1,"bodySize":0},"response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Date","value":"Sat, 03 Oct 2026 15:58:47 GMT"},{"name":"Content-Type","value":"text/html"},{"name":"Transfer-Encoding","value":"chunked"},{"name":"Connection","value":"keep-alive"},{"name":"Server","value":"cloudflare"},{"name":"last-modified","value":"Wed, 30 Sep 2026 19:01:36 GMT"},{"name":"x-amz-version-id","value":"lDEj1NFwvVnxmNh11J_haRTpMyEr3Q1c"},{"name":"Report-To","value":"{\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=NLWD7lCoBqRX2IsEfggO9rmVxGrUVEL9JsmDjUOVMwmUkqEhVAjplVLhe0u2WTbos4rNA58VcGXbV4v9b1PZsfOWl6qLVoxJJaa4NHBs3RUPrelR8EV%2B2WxK1vQUcLRhEBjiTLg4cry6PAeHoERKT4pMwSryyF8m\"}]}"},{"name":"Nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-cache","value":"Error from cloudfront"},{"name":"via","value":"1.1 2e5d524c8ded57fa1cf6d279bf3de040.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-pop","value":"DFW56-P13"},{"name":"x-amz-cf-id","value":"8YPmQdfc7MpmUREZ_N8oLsxJkUqyasAY06-xy8clZjZYrkd21dm7zQ=="},{"name":"Age","value":"6792"},{"name":"Cache-Control","value":"max-age=14400"},{"name":"cf-cache-status","value":"HIT"},{"name":"Content-Encoding","value":"br"},{"name":"CF-RAY","value":"a44d267ccaab0c11-DFW"}],"content":{"mimeType":"text/html","size":11649,"text":"<!doctype html>\r\n<html lang=\"es-MX\" data-beasties-container=\"\">\r\n\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"robots\" content=\"noindex, nofollow\">\r\n  <meta name=\"googlebot\" content=\"noindex, nofollow\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\r\n  <meta name=\"theme-color\" content=\"#fff\">\r\n  <title>Registro de Líneas Telefónicas</title>\r\n  <base href=\"/\">\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\">\r\n\r\n  <style>\r\n    #boot-splash {\r\n      position: fixed;\r\n      inset: 0;\r\n      z-index: 2147483000;\r\n      display: grid;\r\n      grid-template-rows: 1fr auto 58px 1fr;\r\n      justify-items: center;\r\n      align-items: center;\r\n      padding: 24px;\r\n      background: radial-gradient(circle at center, #ffffff 0%, #f5f9fc 100%);\r\n      opacity: 1;\r\n      visibility: visible;\r\n      transition: opacity 180ms ease, visibility 180ms ease;\r\n    }\r\n\r\n    body.app-ready #boot-splash {\r\n      opacity: 0;\r\n      visibility: hidden;\r\n      pointer-events: none;\r\n    }\r\n\r\n    body.boot-splash-instant #boot-splash {\r\n      transition: none;\r\n    }\r\n\r\n    .boot-splash__card {\r\n      grid-row: 2;\r\n      width: min(100%, 320px);\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n    }\r\n\r\n    .boot-splash__logo-wrapper {\r\n      position: relative;\r\n      width: min(100%, 180px);\r\n      aspect-ratio: 227 / 169;\r\n      display: grid;\r\n      place-items: center;\r\n      overflow: hidden;\r\n      border-radius: 20px;\r\n      isolation: isolate;\r\n    }\r\n\r\n    .boot-splash__logo {\r\n      width: 100%;\r\n      height: 100%;\r\n      display: block;\r\n      object-fit: contain;\r\n    }\r\n\r\n    .boot-splash__shimmer {\r\n      position: absolute;\r\n      top: -18%;\r\n      bottom: -18%;\r\n      left: -45%;\r\n      width: 42%;\r\n      background: linear-gradient(105deg,\r\n          transparent 0%,\r\n          rgba(255, 255, 255, 0) 22%,\r\n          rgba(255, 255, 255, 0.78) 50%,\r\n          rgba(255, 255, 255, 0) 78%,\r\n          transparent 100%);\r\n      mix-blend-mode: screen;\r\n      filter: blur(10px);\r\n      animation: boot-logo-shimmer 1.05s ease-in-out infinite;\r\n      pointer-events: none;\r\n    }\r\n\r\n    .boot-splash__status {\r\n      grid-row: 3;\r\n      height: 40px;\r\n      margin-top: 18px;\r\n      display: flex;\r\n      flex-direction: column;\r\n      align-items: center;\r\n      justify-content: flex-start;\r\n      gap: 6px;\r\n      font-family: 'Telefonica', Arial, sans-serif;\r\n      font-size: 12px;\r\n      color: #8d8d8d;\r\n      font-weight: 400;\r\n      letter-spacing: .2px;\r\n    }\r\n\r\n    .boot-splash__message {\r\n      display: grid;\r\n      grid-template-columns: 1.8ch auto 1.8ch;\r\n      align-items: baseline;\r\n      justify-content: center;\r\n    }\r\n\r\n    .boot-splash__message::before {\r\n      content: '';\r\n      display: block;\r\n      width: 1.8ch;\r\n    }\r\n\r\n    .boot-splash__message-text {\r\n      grid-column: 2;\r\n      text-align: center;\r\n    }\r\n\r\n    .boot-splash__dots {\r\n      grid-column: 3;\r\n      width: 1.8ch;\r\n      text-align: left;\r\n    }\r\n\r\n    .boot-splash__reload-row {\r\n      min-height: 18px;\r\n    }\r\n\r\n    .boot-splash__reload {\r\n      display: inline-block;\r\n      color: #019df4;\r\n      font-weight: 600;\r\n      font-family: 'Telefonica', Arial, sans-serif;\r\n      font-size: 12px;\r\n      text-decoration: none;\r\n      background: none;\r\n      border: none;\r\n      cursor: pointer;\r\n      padding: 2px 6px;\r\n      visibility: hidden;\r\n      pointer-events: none;\r\n      transform: translateX(3px);\r\n    }\r\n\r\n    .boot-splash__reload.visible {\r\n      visibility: visible;\r\n      pointer-events: auto;\r\n    }\r\n\r\n    .boot-splash__corner {\r\n      position: absolute;\r\n      right: 10px;\r\n      bottom: 10px;\r\n      font-family: 'Telefonica', Arial, sans-serif;\r\n      font-size: 12px;\r\n      font-weight: 700;\r\n      color: #8d8d8d;\r\n    }\r\n\r\n    @keyframes boot-logo-shimmer {\r\n      0% { transform: translateX(-120%) rotate(14deg); opacity: 0; }\r\n      15%, 82% { opacity: 1; }\r\n      100% { transform: translateX(520%) rotate(14deg); opacity: 0; }\r\n    }\r\n\r\n    @media (max-width: 576px) {\r\n      #boot-splash { padding: 20px; }\r\n      .boot-splash__card { width: min(100%, 260px); }\r\n      .boot-splash__logo-wrapper { width: min(100%, 150px); }\r\n    }\r\n  </style>\r\n  <script src=\"/assets/js/boot-splash.js\" defer=\"\"></script>\r\n<style>:root{--fa-family-brands:\"Font Awesome 7 Brands\";--fa-font-brands:normal 400 1em/1 var(--fa-family-brands)}:root{--fa-font-regular:normal 400 1em/1 var(--fa-family-classic)}:root{--fa-family-classic:\"Font Awesome 7 Free\";--fa-font-solid:normal 900 1em/1 var(--fa-family-classic);--fa-style-family-classic:var(--fa-family-classic)}:root{--bs-blue:#0d6efd;--bs-indigo:#6610f2;--bs-purple:#6f42c1;--bs-pink:#d63384;--bs-red:#dc3545;--bs-orange:#fd7e14;--bs-yellow:#ffc107;--bs-green:#198754;--bs-teal:#20c997;--bs-cyan:#0dcaf0;--bs-black:#000;--bs-white:#fff;--bs-gray:#6c757d;--bs-gray-dark:#343a40;--bs-gray-100:#f8f9fa;--bs-gray-200:#e9ecef;--bs-gray-300:#dee2e6;--bs-gray-400:#ced4da;--bs-gray-500:#adb5bd;--bs-gray-600:#6c757d;--bs-gray-700:#495057;--bs-gray-800:#343a40;--bs-gray-900:#212529;--bs-primary:#0d6efd;--bs-secondary:#6c757d;--bs-success:#198754;--bs-info:#0dcaf0;--bs-warning:#ffc107;--bs-danger:#dc3545;--bs-light:#f8f9fa;--bs-dark:#212529;--bs-primary-rgb:13,110,253;--bs-secondary-rgb:108,117,125;--bs-success-rgb:25,135,84;--bs-info-rgb:13,202,240;--bs-warning-rgb:255,193,7;--bs-danger-rgb:220,53,69;--bs-light-rgb:248,249,250;--bs-dark-rgb:33,37,41;--bs-primary-text-emphasis:#052c65;--bs-