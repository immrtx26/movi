\"group\":\"cf-nel\",\"max_age\":604800,\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=85Wew%2FTMmK2y2U2yAeybFASAI3GRrQW1tH9Vy0kh8c3XNsLj%2FfXDg46niguQLiQ2zA4GYGvhpE9fdonc5DIF6D6KijmaKxsDJeakXGyy4Qters5vcsfe682K4hghux2WO5jsbrS3rCvEK%2FEiJshgvUagHw6dcv0V\"}]}"},{"name":"Nel","value":"{\"report_to\":\"cf-nel\",\"success_fraction\":0.0,\"max_age\":604800}"},{"name":"vary","value":"Accept-Encoding"},{"name":"x-cache","value":"Error from cloudfront"},{"name":"via","value":"1.1 2e5d524c8ded57fa1cf6d279bf3de040.cloudfront.net (CloudFront)"},{"name":"x-amz-cf-pop","value":"DFW56-P13"},{"name":"x-amz-cf-id","value":"8YPmQdfc7MpmUREZ_N8oLsxJkUqyasAY06-xy8clZjZYrkd21dm7zQ=="},{"name":"Age","value":"6804"},{"name":"Cache-Control","value":"max-age=14400"},{"name":"cf-cache-status","value":"HIT"},{"name":"Content-Encoding","value":"br"},{"name":"CF-RAY","value":"a44d26c6dac54aa7-DFW"}],"content":{"mimeType":"text/html","size":11649,"text":"<!doctype html>\r\n<html lang=\"es-MX\" data-beasties-container=\"\">\r\n\r\n<head>\r\n  <meta charset=\"utf-8\">\r\n  <meta name=\"robots\" content=\"noindex, nofollow\">\r\n  <meta name=\"googlebot\" content=\"noindex, nofollow\">\r\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no\">\r\n  <meta name=\"theme-color\" content=\"#fff\">\r\n  <title>Registro de Líneas Telefónicas</title>\r\n  <base href=\"/\">\r\n  <link rel=\"icon\" type=\"image/x-icon\" href=\"favicon.ico\">\r\n\r\n  <style>\r\n    #boot-splash {\r\n      position: fixed;\r\n      inset: 0;\r\n      z-index: 2147483000;\r\n      display: grid;\r\n      grid-template-rows: 1fr auto 58px 1fr;\r\n      justify-items: center;\r\n      align-items: center;\r\n      padding: 24px;\r\n      background: radial-gradient(circle at center, #ffffff 0%, #f5f9fc 100%);\r\n      opacity: 1;\r\n      visibility: visible;\r\n      transition: opacity 180ms ease, visibility 180ms ease;\r\n    }\r\n\r\n    body.app-ready #boot-splash {\r\n      opacity: 0;\r\n      visibility: hidden;\r\n      pointer-events: none;\r\n    }\r\n\r\n    body.boot-splash-instant #boot-splash {\r\n      transition: none;\r\n    }\r\n\r\n    .boot-splash__card {\r\n      grid-row: 2;\r\n      width: min(100%, 320px);\r\n      display: flex;\r\n      align-items: center;\r\n      justify-content: center;\r\n    }\r\n\r\n    .boot-splash__logo-wrapper {\r\n      position: relative;\r\n      width: min(100%, 180px);\r\n      aspect-ratio: 227 / 169;\r\n      display: grid;\r\n      place-items: center;\r\n      overflow: hidden;\r\n      border-radius: 20px;\r\n      isolation: isolate;\r\n    }\r\n\r\n    .boot-splash__logo {\r\n      width: 100%;\r\n      height: 100%;\r\n      display: block;\r\n      object-fit: contain;\r\n    }\r\n\r\n    .boot-splash__shimmer {\r\n      position: absolute;\r\n      top: -18%;\r\n      bottom: -18%;\r\n      left: -45%;\r\n      width: 42%;\r\n      background: linear-gradient(105deg,\r\n          transparent 0%,\r\n          rgba(255, 255, 255, 0) 22%,\r\n          rgba(255, 255, 255, 0.78) 50%,\r\n          rgba(255, 255, 255, 0) 78%,\r\n          transparent 100%);\r\n      mix-blend-mode: screen;\r\n      filter: blur(10px);\r\n      animation: boot-logo-shimmer 1.05s ease-in-out infinite;\r\n      pointer-events: none;\r\n    }\r\n\r\n    .boot-splash__status {\r\n      grid-row: 3;\r\n      height: 40px;\r\n      margin-top: 18px;\r\n      display: flex;\r\n      flex-direction: column;\r\n      align-items: center;\r\n      justify-content: flex-start;\r\n      gap: 6px;\r\n      font-family: 'Telefonica', Arial, sans-serif;\r\n      font-size: 12px;\r\n      color: #8d8d8d;\r\n      font-weight: 400;\r\n      letter-spacing: .2px;\r\n    }\r\n\r\n    .boot-splash__message {\r\n      display: grid;\r\n      grid-template-columns: 1.8ch auto 1.8ch;\r\n      align-items: baseline;\r\n      justify-content: center;\r\n    }\r\n\r\n    .boot-splash__message::before {\r\n      content: '';\r\n      display: block;\r\n      width: 1.8ch;\r\n    }\r\n\r\n    .boot-splash__message-text {\r\n      grid-column: 2;\r\n      text-align: center;\r\n    }\r\n\r\n    .boot-splash__dots {\r\n      grid-column: 3;\r\n      width: 1.8ch;\r\n      text-align: left;\r\n    }\r\n\r\n    .boot-splash__reload-row {\r\n      min-height: 18px;\r\n    }\r\n\r\n    .boot-splash__reload {\r\n      display: inline-block;\r\n      color: #019df4;\r\n      font-weight: 600;\r\n      font-family: 'Telefonica', Arial, sans-serif;\r\n      font-size: 12px;\r\n      text-decoration: none;\r\n      background: none;\r\n      border: none;\r\n      cursor: pointer;\r\n      padding: 2px 6px;\r\n      visibility: hidden;\r\n      pointer-events: none;\r\n      transform: translateX(3px);\r\n    }\r\n\r\n    .boot-splash__reload.visible {\r\n      visibility: visible;\r\n      pointer-events: auto;\r\n    }\r\n\r\n    .boot-splash__corner {\r\n      position: absolute;\r\n      right: 10px;\r\n      bottom: 10px;\r\n      font-family: 'Telefonica', Arial, sans-serif;\r\n      font-size: 12px;\r\n      font-weight: 700;\r\n      color: #8d8d8d;\r\n    }\r\n\r\n    @keyframes boot-logo-shimmer {\r\n      0% { transform: translateX(-120%) rotate(14deg); opacity: 0; }\r\n      15%, 82% { opacity: 1; }\r\n      100% { transform: translateX(520%) rotate(14deg); opacity: 0; }\r\n    }\r\n\r\n    @media (max-width: 576px) {\r\n      #boot-splash { padding: 20px; }\r\n      .boot-splash__card { width: min(100%, 260px); }\r\n      .boot-splash__logo-wrapper { width: min(100%, 150px); }\r\n    }\r\n  </style>\r\n  <script src=\"/assets/js/boot-splash.js\" defer=\"\"></script>\r\n<style>:root{--fa-family-brands:\"Font Awesome 7 Brands\";--fa-font-brands:normal 400 1em/1 var(--fa-family-brands)}:root{--fa-font-regular:normal 400 1em/1 var(--fa-family-classic)}:root{--fa-family-classic:\"Font Awesome 7 Free\";--fa-font-solid:normal 900 1em/1 var(--fa-family-classic);--fa-